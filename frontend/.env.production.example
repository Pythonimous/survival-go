# Production build: absolute API origin for S3 + CloudFront static hosting.
# Leave empty for same-origin relative paths (Vite dev proxy or nginx /api proxy).
VITE_API_BASE_URL=https://api.example.com

# Optional ONNX model artifact source overrides. Defaults fetch directly from
# the Hugging Face `kaya-go/kaya` repo (public, CORS-enabled, 1y cache).
#
# Self-hosting example (place files under frontend/public/models/ with the
# legacy `kaya.<variant>.onnx` filenames):
# VITE_ONNX_MODEL_BASE_URL=/models
# VITE_ONNX_MODEL_FILENAME_PREFIX=kaya
#
# CDN mirror with the upstream Kaya naming:
# VITE_ONNX_MODEL_BASE_URL=https://cdn.example.com/kaya
# VITE_ONNX_MODEL_FILENAME_PREFIX=kata1-b28c512nbt-s12043015936-d5616446734
