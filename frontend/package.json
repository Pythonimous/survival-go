{
  "name": "survival-go-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "copy-ort-wasm": "node ./scripts/copy-ort-wasm.mjs",
    "copy-coi-serviceworker": "node ./scripts/copy-coi-serviceworker.mjs",
    "copy-runtime-assets": "npm run copy-ort-wasm && npm run copy-coi-serviceworker",
    "postinstall": "npm run copy-runtime-assets",
    "prebuild": "npm run copy-runtime-assets",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sabaki/shudan": "^1.7.1",
    "coi-serviceworker": "0.1.7",
    "onnxruntime-web": "1.24.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
