# Copy to .env at the repo root (gitignored). Use absolute paths.
# Full reference: docs/development/environment.md

# --- Required (fail fast if missing or not a file) ---
KATAGO_BINARY_PATH=/absolute/path/to/katago
# Local dev: third_party/katago/analysis.cfg
# Docker / light multi-user: third_party/katago/analysis.docker.cfg
KATAGO_CONFIG_PATH=/absolute/path/to/analysis.cfg
KATAGO_MODEL_PATH=/absolute/path/to/model.bin.gz

# --- Optional (production-safe defaults shown) ---
SURVIVAL_THRESHOLD=0.95
KATAGO_TOP_N=8
# Per-request timeout; local dev default 30. Raise for Docker queue wait (45–60).
KATAGO_ANALYSIS_TIMEOUT_SECONDS=30
