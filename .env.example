# Copy to .env after running scripts/setup_katago.sh (or set paths manually).
KATAGO_BINARY_PATH=/absolute/path/to/katago
KATAGO_CONFIG_PATH=/absolute/path/to/analysis.cfg
KATAGO_MODEL_PATH=/absolute/path/to/model.bin.gz

# Optional overrides (defaults shown)
# SURVIVAL_THRESHOLD=0.95
# KATAGO_TOP_N=8
# KATAGO_ANALYSIS_TIMEOUT_SECONDS=30
