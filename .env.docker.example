# Reference env for docker-compose.yml (values are set in compose; copy only if customizing).
# Full reference: docs/development/environment.md
# KataGo is downloaded into the backend image at build time via scripts/setup_katago.sh.

# --- Required (container paths; baked into docker/backend/Dockerfile) ---
KATAGO_BINARY_PATH=/opt/katago/katago
KATAGO_CONFIG_PATH=/app/third_party/katago/analysis.docker.cfg
KATAGO_MODEL_PATH=/opt/katago/kata1-b20c256x2-s4384473088-d968438914.bin.gz

# --- Optional (production-safe defaults for light concurrent load) ---
SURVIVAL_THRESHOLD=0.95
KATAGO_TOP_N=8
KATAGO_ANALYSIS_TIMEOUT_SECONDS=45
